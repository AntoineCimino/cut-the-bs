# Optional override for config/config.yaml: claude_cli | anthropic_api | fcc_claude
SYNTHESIS_BACKEND=claude_cli
SYNTHESIS_MODEL=sonnet
SYNTHESIS_TIMEOUT_SECONDS=300

# Optional; required only for the anthropic_api backend.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional; only if your fcc-claude installation/provider requires it.
FCC_CLAUDE_API_KEY=your_fcc_claude_api_key_here
